{
  "name": "anthony-sprackling-freelance-website",
  "compatibility_date": "2026-07-01",
  // Worker handles the lead magnet form and gate; everything else is static files.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/resources/*"]
  }
}
